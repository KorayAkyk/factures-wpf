<Window x:Class="Factures.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factures WPF"
        Language="fr-FR"
        Icon="pack://application:,,,/FacturesWpf;component/Assets/app.ico"
        Width="1200" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource PageBackgroundBrush}"
        AutomationProperties.AutomationId="main-window">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="{StaticResource SidebarBrush}" Padding="12,18">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Factures" Foreground="White"
                   FontSize="20" FontWeight="SemiBold" Margin="14,0,0,20" />
        <TextBlock DockPanel.Dock="Bottom" Text="Données de démonstration inventées"
                   Foreground="{StaticResource SidebarTextBrush}" FontSize="11"
                   TextWrapping="Wrap" Margin="14,0,0,0" />
        <ItemsControl ItemsSource="{Binding NavItems}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource NavButton}"
                      Content="{Binding Label}"
                      Command="{Binding OpenCommand}"
                      AutomationProperties.AutomationId="{Binding AutomationId}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top"
              DataContext="{Binding Notifications}"
              Style="{StaticResource NotificationBanner}"
              Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.AutomationId="notification-banner">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                  Content="Fermer" Command="{Binding ClearCommand}"
                  AutomationProperties.AutomationId="notification-close" />
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                     AutomationProperties.AutomationId="notification-text" />
        </DockPanel>
      </Border>

      <ProgressBar DockPanel.Dock="Top" Height="3" BorderThickness="0" Background="Transparent"
                   Foreground="{StaticResource AccentBrush}" IsIndeterminate="True"
                   Visibility="{Binding Navigation.CurrentPage.IsBusy, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

      <ContentControl Content="{Binding Navigation.CurrentPage}" Margin="24,20" Focusable="False" />
    </DockPanel>
  </Grid>
</Window>
