<UserControl x:Class="Factures.App.Views.ClientListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="clients-page">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top">
      <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Nouveau client"
              Margin="0" VerticalAlignment="Top" Command="{Binding NewCommand}"
              AutomationProperties.AutomationId="client-new" />
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                 AutomationProperties.AutomationId="page-title" />
    </DockPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <DataGrid Style="{StaticResource ReadOnlyGrid}"
                ItemsSource="{Binding Clients}"
                SelectedItem="{Binding SelectedClient}"
                AutomationProperties.AutomationId="clients-grid">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*" />
          <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="2*" />
          <DataGridTextColumn Header="Délai (jours)" Binding="{Binding PaymentTermDays}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="Nom" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                   AutomationProperties.AutomationId="client-name" AutomationProperties.Name="Nom" />
          <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                   AutomationProperties.AutomationId="client-email" AutomationProperties.Name="E-mail" />
          <TextBlock Text="Délai de paiement (jours)" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding PaymentTermDays, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,0,0,14"
                   AutomationProperties.AutomationId="client-term" AutomationProperties.Name="Délai de paiement" />
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer" Command="{Binding SaveCommand}"
                    AutomationProperties.AutomationId="client-save" />
            <Button Style="{StaticResource DangerButton}" Content="Supprimer" Command="{Binding DeleteCommand}"
                    AutomationProperties.AutomationId="client-delete" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
