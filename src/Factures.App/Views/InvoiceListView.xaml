<UserControl x:Class="Factures.App.Views.InvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="invoices-page">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top">
      <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Nouvelle facture"
              Margin="0" VerticalAlignment="Top" Command="{Binding NewCommand}"
              AutomationProperties.AutomationId="invoice-new" />
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                 AutomationProperties.AutomationId="page-title" />
    </DockPanel>

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
            DataContext="{Binding Filters}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3">
          <TextBlock Text="Recherche (numéro, client, objet)" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.AutomationId="filter-search"
                   AutomationProperties.Name="Recherche" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="Statut" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                    DisplayMemberPath="Label" AutomationProperties.AutomationId="filter-status"
                    AutomationProperties.Name="Statut" />
        </StackPanel>
        <StackPanel Grid.Column="6">
          <TextBlock Text="Client" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding ClientOptions}" SelectedItem="{Binding SelectedClient}"
                    DisplayMemberPath="Label" AutomationProperties.AutomationId="filter-client"
                    AutomationProperties.Name="Client" />
        </StackPanel>
        <StackPanel Grid.Row="2">
          <TextBlock Text="Émise à partir du" Style="{StaticResource FieldLabel}" />
          <DatePicker SelectedDate="{Binding IssuedFrom, Converter={StaticResource DateOnlyToDateTime}}"
                      AutomationProperties.Name="Émise à partir du" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2">
          <TextBlock Text="Jusqu'au" Style="{StaticResource FieldLabel}" />
          <DatePicker SelectedDate="{Binding IssuedTo, Converter={StaticResource DateOnlyToDateTime}}"
                      AutomationProperties.Name="Jusqu'au" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="4">
          <TextBlock Text="Tri" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                    DisplayMemberPath="Label" AutomationProperties.Name="Tri" />
        </StackPanel>
        <Button Grid.Row="2" Grid.Column="6" Style="{StaticResource LinkButton}" Content="Effacer les filtres"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,2"
                Command="{Binding ResetCommand}" AutomationProperties.AutomationId="filter-reset" />
      </Grid>
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock DockPanel.Dock="Right" Text="{Binding ResultSummary}" Style="{StaticResource MutedText}"
                 VerticalAlignment="Center" AutomationProperties.AutomationId="result-summary" />
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource SecondaryButton}" Content="Modifier" Command="{Binding EditCommand}"
                AutomationProperties.AutomationId="invoice-edit" />
        <Button Style="{StaticResource SecondaryButton}" Content="Marquer envoyée" Command="{Binding SendCommand}"
                AutomationProperties.AutomationId="invoice-send" />
        <Button Style="{StaticResource SecondaryButton}" Content="Marquer payée" Command="{Binding MarkPaidCommand}"
                AutomationProperties.AutomationId="invoice-paid" />
        <Button Style="{StaticResource DangerButton}" Content="Supprimer" Command="{Binding DeleteCommand}"
                AutomationProperties.AutomationId="invoice-delete" />
        <Button Style="{StaticResource SecondaryButton}" Content="Exporter en CSV" Command="{Binding ExportCsvCommand}"
                AutomationProperties.AutomationId="invoice-export" />
      </StackPanel>
    </DockPanel>

    <DataGrid Style="{StaticResource ReadOnlyGrid}"
              ItemsSource="{Binding Results}"
              SelectedItem="{Binding SelectedInvoice}"
              AutomationProperties.AutomationId="invoices-grid">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Numéro" Binding="{Binding DisplayNumber}" Width="120" />
        <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="5*" />
        <DataGridTextColumn Header="Objet" Binding="{Binding Subject}" Width="6*" />
        <DataGridTextColumn Header="Date" Binding="{Binding IssueDate, StringFormat={}{0:dd/MM/yyyy}}" Width="90" />
        <DataGridTextColumn Header="Échéance" Binding="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}}" Width="90" />
        <DataGridTemplateColumn Header="Statut" Width="100" CellTemplate="{StaticResource StatusBadgeTemplate}" />
        <DataGridTextColumn Header="Total TTC" Width="100"
                            Binding="{Binding TotalIncludingTax, StringFormat={}{0:C2}}"
                            ElementStyle="{StaticResource RightAlignedCellText}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
