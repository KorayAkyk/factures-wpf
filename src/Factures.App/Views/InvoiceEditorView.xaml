<UserControl x:Class="Factures.App.Views.InvoiceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="invoice-editor-page">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitle}"
               AutomationProperties.AutomationId="page-title" />

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Client" Style="{StaticResource FieldLabel}" />
          <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                    DisplayMemberPath="Name" AutomationProperties.AutomationId="editor-client"
                    AutomationProperties.Name="Client" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Objet" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.AutomationId="editor-subject"
                   AutomationProperties.Name="Objet" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
          <DatePicker SelectedDate="{Binding IssueDate, Converter={StaticResource DateOnlyToDateTime}}"
                      AutomationProperties.Name="Date" />
        </StackPanel>
        <StackPanel Grid.Column="6">
          <TextBlock Text="Échéance" Style="{StaticResource FieldLabel}" />
          <DatePicker SelectedDate="{Binding DueDate, Converter={StaticResource DateOnlyToDateTime}}"
                      AutomationProperties.Name="Échéance" />
        </StackPanel>
      </Grid>
    </Border>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource SecondaryButton}" Content="Annuler" Command="{Binding CancelCommand}"
                AutomationProperties.AutomationId="editor-cancel" />
        <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer le brouillon" Margin="0"
                Command="{Binding SaveCommand}" AutomationProperties.AutomationId="editor-save" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,16,0">
          <Run Text="Total HT : " /><Run Text="{Binding TotalExcludingTax, Mode=OneWay, StringFormat={}{0:C2}}" />
        </TextBlock>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,16,0">
          <Run Text="TVA : " /><Run Text="{Binding TotalTax, Mode=OneWay, StringFormat={}{0:C2}}" />
        </TextBlock>
        <TextBlock FontWeight="SemiBold" FontSize="15" AutomationProperties.AutomationId="editor-total">
          <Run Text="Total TTC : " /><Run Text="{Binding TotalIncludingTax, Mode=OneWay, StringFormat={}{0:C2}}" />
        </TextBlock>
      </StackPanel>
    </DockPanel>

    <Border Style="{StaticResource Card}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Ajouter une ligne" Margin="0"
                  Command="{Binding AddLineCommand}" AutomationProperties.AutomationId="editor-add-line" />
          <TextBlock Text="Lignes" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Lines}"
                  AutomationProperties.AutomationId="editor-lines">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Description" Width="4*"
                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
            <DataGridTextColumn Header="Quantité" Width="90"
                                Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            <DataGridTextColumn Header="Prix unitaire HT" Width="120"
                                Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
            <DataGridTemplateColumn Header="TVA (%)" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox BorderThickness="0" Background="Transparent"
                            ItemsSource="{Binding DataContext.VatRates, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            SelectedItem="{Binding VatRate, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Taux de TVA" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Total HT" Width="110" IsReadOnly="True"
                                Binding="{Binding TotalExcludingTax, Mode=OneWay, StringFormat={}{0:C2}}"
                                ElementStyle="{StaticResource RightAlignedCellText}" />
            <DataGridTemplateColumn Header="" Width="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource LinkButton}" Content="Retirer"
                          Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" AutomationProperties.Name="Retirer la ligne" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
