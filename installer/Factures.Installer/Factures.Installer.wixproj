<Project Sdk="WixToolset.Sdk">
  <!-- Le MSI embarque le dossier produit par la publication. Voir build/Package.proj. -->
  <PropertyGroup>
    <OutputName>FacturesWpf-$(Version)-x64</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishedAppDir Condition="'$(PublishedAppDir)' == ''">$(RepoRoot)artifacts\publish\</PublishedAppDir>
    <DefineConstants>ProductVersion=$(Version);RepoRoot=$(RepoRoot)</DefineConstants>
    <Cultures>fr-FR</Cultures>
    <!-- ICE60 signale des bibliotheques du runtime .NET sans langue declaree : sans effet ici. -->
    <SuppressIces>ICE60</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
    <BindPath Include="$(PublishedAppDir.TrimEnd('\'))" BindName="PublishedApp" />
  </ItemGroup>

  <!-- Echoue tout de suite, avec un message clair, plutot qu'un MSI vide. -->
  <Target Name="VerifyPublishedApp" BeforeTargets="CoreCompile;Compile">
    <Error Condition="!Exists('$(PublishedAppDir)FacturesWpf.exe')"
           Text="Application non publiee dans '$(PublishedAppDir)'. Lancez d'abord : dotnet msbuild build/Package.proj -t:Publish" />
  </Target>
</Project>
